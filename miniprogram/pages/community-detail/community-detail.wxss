/* pages/community-detail/community-detail.wxss */
.page-detail {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f6fc;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.nav-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #2d2a35;
  line-height: 1;
}
.nav-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 700; color: #2d2a35; }
.nav-action {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #7a7485;
}

.detail-scroll {
  flex: 1;
}

/* 帖子正文 */
.post-detail {
  background: #fff;
  padding: 32rpx;
  margin: 16rpx;
  border-radius: 20rpx;
}
.pd-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.pd-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.pd-author { flex: 1; }
.pd-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d2a35;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.pd-mine {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  background: rgba(139, 111, 212, 0.15);
  color: #8b6fd4;
  border-radius: 8rpx;
}
.pd-meta { font-size: 22rpx; color: #7a7485; margin-top: 4rpx; }
.pd-mood {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}
.pd-content {
  font-size: 30rpx;
  color: #2d2a35;
  line-height: 1.8;
  margin-bottom: 24rpx;
}
.pd-footer {
  display: flex;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e8e4f0;
}
.pd-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #7a7485;
}
.pd-action.liked { color: #e85a5a; }
.pa-icon { font-size: 32rpx; }

.divider {
  height: 16rpx;
  background: #f8f6fc;
}

/* 评论 */
.comments-section { padding: 24rpx 32rpx; }
.cs-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-bottom: 20rpx;
}
.cs-empty {
  text-align: center;
  padding: 60rpx 20rpx;
  font-size: 24rpx;
  color: #b8b3c4;
}
.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0edf5;
}
.comment-item:last-child { border-bottom: none; }
.c-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.c-body { flex: 1; }
.c-name { font-size: 24rpx; color: #8b6fd4; font-weight: 600; margin-bottom: 4rpx; }
.c-text { font-size: 26rpx; color: #2d2a35; line-height: 1.6; }
.c-time { font-size: 20rpx; color: #b8b3c4; margin-top: 6rpx; }

.bottom-pad { height: 40rpx; }

/* 评论栏 */
.comment-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #e8e4f0;
  flex-shrink: 0;
}
.cb-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: #f8f6fc;
  border-radius: 36rpx;
  font-size: 26rpx;
  border: 1rpx solid #e8e4f0;
}
.cb-send {
  padding: 16rpx 32rpx;
  background: #e8e4f0;
  color: #b8b3c4;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.cb-send.active {
  background: linear-gradient(135deg, #8b6fd4, #f08a7a);
  color: #fff;
}
.input-ph { color: #b8b3c4; }

/* 操作菜单 */
.action-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 0 env(safe-bottom);
}
.modal-mask {
  background: rgba(45, 42, 53, 0.55);
  align-items: flex-end;
}
.as-item {
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: #2d2a35;
  text-align: center;
  border-bottom: 1rpx solid #f0edf5;
}
.as-item:active { background: #f8f6fc; }
.as-item.as-cancel {
  color: #7a7485;
  margin-top: 12rpx;
  border-top: 12rpx solid #f8f6fc;
  border-bottom: none;
}
