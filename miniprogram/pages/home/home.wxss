/* pages/home/home.wxss */
.page-home {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* Hero */
.hero {
  margin: 24rpx 32rpx 40rpx;
  padding: 56rpx 40rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8b6fd4 0%, #f08a7a 100%);
  box-shadow: 0 12rpx 40rpx rgba(139, 111, 212, 0.22);
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}
.hero-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.22);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #fff;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.hero-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1.1;
  margin-bottom: 12rpx;
}
.hero-tagline {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}
.hero-quote {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.quote-label { font-size: 22rpx; color: rgba(255,255,255,0.8); }
.quote-score { font-size: 30rpx; font-weight: 700; color: #fff; }

/* Sections */
.section { margin: 0 32rpx 36rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #8b6fd4, #f08a7a);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 主入口大卡片 */
.entry-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(139,111,212,0.08), rgba(240,138,122,0.08));
  border: 1rpx solid rgba(139, 111, 212, 0.15);
  box-shadow: 0 4rpx 24rpx rgba(139, 111, 212, 0.08);
}
.entry-main-left { flex: 1; }
.entry-main-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-bottom: 8rpx;
}
.entry-main-desc { font-size: 26rpx; color: #7a7485; margin-bottom: 16rpx; }
.entry-main-meta { display: flex; gap: 12rpx; }
.meta-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(139, 111, 212, 0.12);
  color: #8b6fd4;
  font-weight: 600;
}
.meta-tag-ghost { background: rgba(122,116,133,0.1); color: #7a7485; }
.entry-main-icon {
  font-size: 80rpx;
  margin-left: 24rpx;
}
.card-hover { transform: scale(0.98); opacity: 0.92; }

/* 网格 */
.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.entry-cell {
  position: relative;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  border: 1rpx solid rgba(139, 111, 212, 0.08);
  box-shadow: 0 2rpx 12rpx rgba(139, 111, 212, 0.04);
}
.cell-hover { transform: scale(0.97); }
.cell-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}
.cell-title { font-size: 30rpx; font-weight: 700; color: #2d2a35; }
.cell-desc { font-size: 22rpx; color: #7a7485; margin-top: 4rpx; }
.cell-tag { position: absolute; top: 20rpx; right: 20rpx; }

/* 今日心情引导 */
.prompt-card {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.85);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(76, 175, 125, 0.2);
}
.prompt-emoji { font-size: 56rpx; margin-right: 24rpx; }
.prompt-text { flex: 1; }
.prompt-title { font-size: 28rpx; font-weight: 600; color: #2d2a35; }
.prompt-desc { font-size: 22rpx; color: #7a7485; margin-top: 4rpx; }
.btn-sm { padding: 12rpx 28rpx; font-size: 24rpx; }

/* 7天趋势小图 */
.mini-trend { padding: 28rpx; }
.mini-trend-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  margin-bottom: 16rpx;
}
.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}
.bar {
  width: 36rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  min-height: 8rpx;
  transition: height 0.3s;
}
.bar-label {
  font-size: 20rpx;
  color: #7a7485;
  margin-top: 8rpx;
}
.mini-trend-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e4f0;
  font-size: 24rpx;
  color: #8b6fd4;
}
.mini-trend-footer .arrow { font-size: 36rpx; }

/* 免责声明 */
.disclaimer {
  margin: 40rpx 32rpx 0;
  padding: 24rpx;
  font-size: 22rpx;
  color: #7a7485;
  text-align: center;
  line-height: 1.7;
}

/* 每日引导弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(45, 42, 53, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  backdrop-filter: blur(8rpx);
}
.modal-body {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  text-align: center;
  animation: modalIn 0.3s ease-out;
}
@keyframes modalIn {
  from { transform: scale(0.85); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.modal-emoji { font-size: 96rpx; margin-bottom: 20rpx; }
.modal-title { font-size: 34rpx; font-weight: 700; color: #2d2a35; margin-bottom: 12rpx; }
.modal-desc { font-size: 26rpx; color: #7a7485; margin-bottom: 36rpx; line-height: 1.6; }
.modal-actions { display: flex; gap: 20rpx; }
.modal-actions .btn { flex: 1; }
