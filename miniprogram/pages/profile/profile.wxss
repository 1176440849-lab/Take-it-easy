/* pages/profile/profile.wxss */
.page-profile {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* 头部 */
.profile-header {
  padding: 80rpx 32rpx 48rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(139,111,212,0.08), transparent);
}
.avatar-wrap {
  display: inline-block;
  padding: 8rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(139, 111, 212, 0.15);
}
.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b6fd4, #f08a7a);
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-top: 24rpx;
}
.user-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  background: rgba(139, 111, 212, 0.1);
  color: #8b6fd4;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.section { margin: 0 32rpx 32rpx; }

/* 统计 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  border: 1rpx solid #e8e4f0;
  box-shadow: 0 2rpx 12rpx rgba(139, 111, 212, 0.04);
}
.stat-item { text-align: center; }
.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #8b6fd4;
  line-height: 1.2;
}
.stat-label {
  font-size: 22rpx;
  color: #7a7485;
  margin-top: 4rpx;
}

/* 额度 */
.quota-card { padding: 28rpx 32rpx; }
.quota-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.quota-label { font-size: 26rpx; color: #2d2a35; font-weight: 600; }
.quota-value { font-size: 36rpx; font-weight: 700; color: #8b6fd4; }
.quota-bar {
  height: 12rpx;
  background: #e8e4f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.quota-fill {
  height: 100%;
  background: linear-gradient(90deg, #8b6fd4, #f08a7a);
  border-radius: 6rpx;
  transition: width 0.3s;
}
.quota-tip {
  font-size: 22rpx;
  color: #7a7485;
  margin-top: 12rpx;
}

/* 菜单 */
.menu-card { padding: 0; overflow: hidden; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e8e4f0;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #f8f6fc; }
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-info { flex: 1; }
.menu-title { font-size: 28rpx; color: #2d2a35; font-weight: 600; }
.menu-desc { font-size: 22rpx; color: #7a7485; margin-top: 4rpx; }
.menu-arrow { font-size: 40rpx; color: #b8b3c4; }

/* 关于 */
.about {
  padding: 40rpx 24rpx;
  text-align: center;
}
.about-title { font-size: 28rpx; font-weight: 700; color: #2d2a35; margin-bottom: 8rpx; }
.about-version { font-size: 22rpx; color: #7a7485; margin-bottom: 24rpx; }
.about-text {
  font-size: 24rpx;
  color: #7a7485;
  line-height: 1.8;
  margin-bottom: 12rpx;
}
