/* pages/coming-soon/coming-soon.wxss */
.page-coming {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  text-align: center;
}
.coming-emoji { font-size: 160rpx; margin-bottom: 24rpx; }
.coming-title { font-size: 40rpx; font-weight: 700; color: #2d2a35; margin-bottom: 12rpx; }
.coming-status {
  display: inline-block;
  padding: 6rpx 24rpx;
  background: rgba(139, 111, 212, 0.12);
  color: #8b6fd4;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}
.coming-desc {
  font-size: 26rpx;
  color: #7a7485;
  line-height: 1.7;
  margin-bottom: 48rpx;
  max-width: 560rpx;
}
.coming-roadmap {
  width: 100%;
  max-width: 560rpx;
  text-align: left;
  margin-bottom: 48rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}
.roadmap-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}
.rm-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e8e4f0;
  margin-top: 6rpx;
  flex-shrink: 0;
}
.rm-dot.active { background: #8b6fd4; box-shadow: 0 0 0 6rpx rgba(139, 111, 212, 0.15); }
.rm-text { font-size: 24rpx; color: #2d2a35; line-height: 1.6; }
