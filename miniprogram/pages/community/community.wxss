/* pages/community/community.wxss */
.page-community {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.page-header {
  padding: 48rpx 32rpx 24rpx;
}
.ph-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.ph-title { font-size: 48rpx; font-weight: 700; color: #2d2a35; }
.ph-desc { font-size: 26rpx; color: #7a7485; margin-top: 8rpx; }

.ph-alias {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx 12rpx 12rpx;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid #e8e4f0;
}
.alias-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.alias-name { font-size: 24rpx; color: #2d2a35; max-width: 160rpx; overflow: hidden; }

/* 筛选条 */
.filter-bar {
  white-space: nowrap;
  padding: 0 32rpx 24rpx;
}
.filter-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx;
}
.filter-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #fff;
  color: #7a7485;
  font-size: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e8e4f0;
  flex-shrink: 0;
}
.filter-item.active {
  background: linear-gradient(135deg, #8b6fd4, #f08a7a);
  color: #fff;
  border-color: transparent;
  font-weight: 600;
}

/* 帖子列表 */
.post-list { padding: 0 32rpx; }
.post-card { padding: 28rpx 32rpx; margin-bottom: 16rpx; }
.post-card:active { transform: scale(0.99); }

.post-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.post-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.post-author { flex: 1; }
.post-name {
  font-size: 26rpx;
  color: #2d2a35;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.post-mine {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  background: rgba(139, 111, 212, 0.15);
  color: #8b6fd4;
  border-radius: 8rpx;
}
.post-meta { font-size: 22rpx; color: #7a7485; margin-top: 4rpx; }
.post-mood {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.post-content {
  font-size: 28rpx;
  color: #2d2a35;
  line-height: 1.7;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.post-footer {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e4f0;
}
.post-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #7a7485;
}
.post-action.liked { color: #e85a5a; }
.pa-icon { font-size: 28rpx; }

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}
.empty-emoji { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.7; }
.empty-text { font-size: 30rpx; color: #2d2a35; font-weight: 600; margin-bottom: 8rpx; }
.empty-desc { font-size: 24rpx; color: #7a7485; }

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #8b6fd4, #f08a7a);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 111, 212, 0.3);
  z-index: 50;
}
.fab:active { transform: scale(0.95); }
.fab-icon { color: #fff; font-size: 32rpx; font-weight: 700; }
.fab-text { color: #fff; font-size: 26rpx; font-weight: 600; }

/* 公约 */
.convention {
  margin: 40rpx 32rpx;
  padding: 24rpx;
  background: rgba(76, 175, 125, 0.06);
  border-radius: 16rpx;
  border-left: 6rpx solid #4caf7d;
}
.conv-title { font-size: 26rpx; font-weight: 700; color: #4caf7d; margin-bottom: 8rpx; }
.conv-text {
  font-size: 22rpx;
  color: #7a7485;
  line-height: 2;
}
.conv-line {
  padding: 2rpx 0;
}

/* 弹窗通用 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(45, 42, 53, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.input-ph { color: #b8b3c4; }

/* 发帖弹窗 */
.post-modal {
  width: 92%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  max-height: 85vh;
  overflow-y: auto;
}
.pm-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.pm-title { font-size: 32rpx; font-weight: 700; color: #2d2a35; }
.pm-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #7a7485;
}
.pm-block { margin-bottom: 24rpx; }
.pm-label { font-size: 24rpx; color: #7a7485; margin-bottom: 12rpx; }
.pm-moods {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.pm-mood {
  padding: 10rpx 20rpx;
  border: 2rpx solid;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #fff;
}
.pm-mood:active { transform: scale(0.95); }
.pm-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  background: #f8f6fc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #2d2a35;
  border: 1rpx solid #e8e4f0;
  box-sizing: border-box;
  line-height: 1.6;
}
.pm-count {
  text-align: right;
  font-size: 20rpx;
  color: #b8b3c4;
  margin-top: 8rpx;
}
.pm-tip {
  font-size: 22rpx;
  color: #7a7485;
  padding: 16rpx;
  background: rgba(139, 111, 212, 0.04);
  border-radius: 12rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.pm-actions { display: flex; gap: 20rpx; }
.pm-actions .btn { flex: 1; }

/* 昵称弹窗 */
.alias-modal {
  width: 92%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.am-title { font-size: 34rpx; font-weight: 700; color: #2d2a35; margin-bottom: 8rpx; }
.am-desc { font-size: 24rpx; color: #7a7485; margin-bottom: 32rpx; }
.am-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.am-preview-avatar {
  width: 120rpx;
  height: 120rpx;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}
.am-preview-name { font-size: 30rpx; font-weight: 600; color: #2d2a35; }
.am-input-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.am-input {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #f8f6fc;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 1rpx solid #e8e4f0;
}
.am-random {
  padding: 20rpx 24rpx;
  background: rgba(139, 111, 212, 0.1);
  color: #8b6fd4;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.am-colors {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.am-color {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}
.am-color.selected { border-color: #2d2a35; transform: scale(1.1); }
.am-actions { display: flex; gap: 20rpx; }
.am-actions .btn { flex: 1; }
