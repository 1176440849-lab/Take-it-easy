/* pages/emotion/emotion.wxss */
.page-emotion {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 48rpx 32rpx 32rpx;
  position: relative;
}
.ph-back {
  position: absolute;
  top: 36rpx;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #2d2a35;
  line-height: 1;
  border-radius: 50%;
}
.ph-back:active { background: rgba(0, 0, 0, 0.06); }
.ph-title { font-size: 48rpx; font-weight: 700; color: #2d2a35; }
.ph-desc { font-size: 26rpx; color: #7a7485; margin-top: 8rpx; }

.section { margin: 0 32rpx 36rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #8b6fd4, #f08a7a);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 记录卡 */
.record-card { padding: 36rpx 32rpx; }
.rc-done {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.rc-done-emoji { font-size: 80rpx; }
.rc-done-info { flex: 1; }
.rc-done-title { font-size: 30rpx; font-weight: 700; color: #2d2a35; }
.rc-done-label { font-size: 24rpx; color: #7a7485; margin-top: 4rpx; }
.rc-done-tags { font-size: 22rpx; color: #8b6fd4; margin-top: 8rpx; }
.rc-done-edit {
  font-size: 24rpx;
  color: #8b6fd4;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(139, 111, 212, 0.3);
  border-radius: 20rpx;
}

.rc-prompt { text-align: center; padding: 24rpx 0; }
.rc-prompt-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.rc-prompt-title { font-size: 32rpx; font-weight: 600; color: #2d2a35; margin-bottom: 8rpx; }
.rc-prompt-desc { font-size: 24rpx; color: #7a7485; margin-bottom: 24rpx; }

/* 表单卡 */
.form-card { padding: 36rpx 32rpx; }
.form-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-bottom: 32rpx;
  text-align: center;
}
.form-block { margin-bottom: 32rpx; }
.block-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2d2a35;
  margin-bottom: 20rpx;
}

/* 分数 */
.score-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.score-value {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
}
.score-label { font-size: 28rpx; font-weight: 600; }
.score-slider { margin: 0 8rpx; }
.score-scale {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #7a7485;
  margin-top: 8rpx;
}

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border: 2rpx solid;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #fff;
  transition: all 0.15s;
}
.tag-item:active { transform: scale(0.95); }

/* 触发来源 */
.trigger-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.trigger-item {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  background: #f8f6fc;
  color: #7a7485;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}
.trigger-item.selected {
  background: rgba(139, 111, 212, 0.12);
  color: #8b6fd4;
  border-color: #8b6fd4;
  font-weight: 600;
}

/* 备注 */
.form-note {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: #f8f6fc;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #2d2a35;
  border: 1rpx solid #e8e4f0;
  box-sizing: border-box;
}
.note-ph { color: #b8b3c4; }
.note-count {
  text-align: right;
  font-size: 20rpx;
  color: #b8b3c4;
  margin-top: 8rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.form-actions .btn { flex: 1; }

/* 7天趋势 */
.trend-card { padding: 32rpx 24rpx; }
.trend-chart {
  display: flex;
  height: 280rpx;
  gap: 16rpx;
}
.trend-yaxis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 18rpx;
  color: #b8b3c4;
  padding: 4rpx 0;
}
.trend-bars {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
}
.trend-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 8rpx;
}
.trend-bar {
  width: 36rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  min-height: 8rpx;
  transition: height 0.3s;
}
.trend-empty {
  width: 36rpx;
  height: 4rpx;
  background: #e8e4f0;
  border-radius: 2rpx;
}
.trend-day { font-size: 22rpx; color: #2d2a35; margin-top: 8rpx; font-weight: 600; }
.trend-date { font-size: 18rpx; color: #b8b3c4; }

.trend-summary {
  display: flex;
  justify-content: space-around;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8e4f0;
}
.ts-item { text-align: center; }
.ts-label { font-size: 20rpx; color: #7a7485; margin-bottom: 4rpx; }
.ts-value { font-size: 32rpx; font-weight: 700; color: #2d2a35; }

/* 模式洞察 */
.insight-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(139,111,212,0.06), rgba(240,138,122,0.06));
  border: 1rpx solid rgba(139, 111, 212, 0.15);
}
.insight-icon { font-size: 56rpx; }
.insight-content { flex: 1; }
.insight-text {
  font-size: 26rpx;
  color: #2d2a35;
  line-height: 1.7;
  margin-bottom: 12rpx;
}
.insight-tip { font-size: 20rpx; color: #7a7485; }

/* 月度热力图 */
.heatmap-card { padding: 28rpx 24rpx; }
.heatmap-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.hm-nav {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #8b6fd4;
  background: rgba(139, 111, 212, 0.08);
  border-radius: 50%;
}
.hm-nav:active { background: rgba(139, 111, 212, 0.18); }
.hm-title { font-size: 30rpx; font-weight: 700; color: #2d2a35; }

.heatmap-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
}
.heatmap-weekdays text {
  text-align: center;
  font-size: 20rpx;
  color: #b8b3c4;
}
.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.hm-cell {
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  background: #f8f6fc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 1rpx solid transparent;
  transition: transform 0.15s;
}
.hm-cell.empty { background: transparent; border: none; }
.hm-cell.today { border-color: #8b6fd4; }
.hm-cell:active { transform: scale(0.92); }
.hm-day { font-size: 22rpx; color: #2d2a35; }
.hm-cell[style*="background"] .hm-day { color: #fff; }
.hm-score { font-size: 18rpx; color: #fff; margin-top: 2rpx; font-weight: 700; }

.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e4f0;
}
.legend-label { font-size: 20rpx; color: #7a7485; }
.legend-cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
}
.legend-tip { font-size: 20rpx; color: #7a7485; margin-left: 8rpx; }

/* 30天趋势 */
.trend30-card { padding: 28rpx 24rpx; }
.t30-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}
.t30-stat { text-align: center; }
.t30-label { font-size: 20rpx; color: #7a7485; margin-bottom: 4rpx; }
.t30-value { font-size: 32rpx; font-weight: 700; color: #2d2a35; }
.t30-unit { font-size: 20rpx; color: #7a7485; font-weight: 400; }

.t30-chart {
  display: flex;
  height: 280rpx;
  gap: 12rpx;
}
.t30-yaxis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 18rpx;
  color: #b8b3c4;
  padding: 4rpx 0;
}
.t30-plot {
  flex: 1;
  position: relative;
  border-left: 1rpx solid #e8e4f0;
  border-bottom: 1rpx solid #e8e4f0;
}
.t30-grid {
  position: absolute;
  left: 0; right: 0;
  height: 1rpx;
  background: #f0edf5;
}
.t30-grid:nth-child(1) { bottom: 25%; }
.t30-grid:nth-child(2) { bottom: 50%; }
.t30-grid:nth-child(3) { bottom: 75%; }
.t30-grid:nth-child(4) { bottom: 100%; }

.t30-line-wrap {
  position: absolute;
  left: 0; right: 0; bottom: 0; top: 0;
}
.t30-bar {
  position: absolute;
  bottom: 0;
  width: 4rpx;
  min-height: 2rpx;
  border-radius: 2rpx 2rpx 0 0;
  opacity: 0.7;
}
.t30-point {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  transform: translate(-50%, 50%);
  border: 2rpx solid #fff;
  z-index: 2;
}

.t30-xaxis {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-left: 30rpx;
  font-size: 18rpx;
  color: #b8b3c4;
}

/* 历史记录 */
.history-item { padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.hi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.hi-date { font-size: 26rpx; color: #7a7485; font-weight: 600; }
.hi-score { font-size: 32rpx; font-weight: 700; }
.hi-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.hi-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.hi-trigger { font-size: 22rpx; color: #7a7485; margin-bottom: 8rpx; }
.hi-note {
  font-size: 26rpx;
  color: #2d2a35;
  line-height: 1.6;
  padding: 12rpx 16rpx;
  background: #f8f6fc;
  border-radius: 12rpx;
  border-left: 4rpx solid #8b6fd4;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #8b6fd4;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}
.empty-emoji { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.7; }
.empty-text { font-size: 30rpx; color: #2d2a35; font-weight: 600; margin-bottom: 8rpx; }
.empty-desc { font-size: 24rpx; color: #7a7485; }

/* 授权弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(45, 42, 53, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.auth-modal {
  width: 640rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  text-align: center;
}
.am-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.am-title { font-size: 34rpx; font-weight: 700; color: #2d2a35; margin-bottom: 16rpx; }
.am-desc {
  font-size: 24rpx;
  color: #7a7485;
  line-height: 1.7;
  text-align: left;
  margin-bottom: 24rpx;
}
.am-points { text-align: left; margin-bottom: 32rpx; }
.am-point { font-size: 22rpx; color: #4caf7d; line-height: 2; }
.am-actions { display: flex; gap: 20rpx; }
.am-actions .btn { flex: 1; }
