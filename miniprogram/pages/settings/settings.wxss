/* pages/settings/settings.wxss */
.page-settings {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 48rpx 32rpx 32rpx;
}
.ph-title { font-size: 48rpx; font-weight: 700; color: #2d2a35; }
.ph-desc { font-size: 26rpx; color: #7a7485; margin-top: 8rpx; }

.section { margin: 0 32rpx 32rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #8b6fd4, #f08a7a);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 模式卡 */
.mode-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
}
.mode-icon { font-size: 64rpx; }
.mode-info { flex: 1; }
.mode-title { font-size: 30rpx; font-weight: 700; color: #2d2a35; margin-bottom: 4rpx; }
.mode-desc { font-size: 24rpx; color: #7a7485; line-height: 1.5; }

/* 表单 */
.form-card { padding: 32rpx; }
.form-block { margin-bottom: 28rpx; }
.block-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2d2a35;
  margin-bottom: 12rpx;
}
.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f8f6fc;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #2d2a35;
  border: 1rpx solid #e8e4f0;
  box-sizing: border-box;
}
.input-ph { color: #b8b3c4; }
.input-with-action {
  position: relative;
}
.input-with-action .form-input { padding-right: 100rpx; }
.input-suffix {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #8b6fd4;
  padding: 8rpx 16rpx;
  background: #fff;
  border-radius: 12rpx;
}
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8f6fc;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #2d2a35;
  border: 1rpx solid #e8e4f0;
  box-sizing: border-box;
  line-height: 1.6;
}
.block-tip {
  font-size: 22rpx;
  color: #7a7485;
  margin-top: 8rpx;
  line-height: 1.5;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.form-actions .btn { flex: 1; }

/* 预设 */
.preset-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.preset-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e8e4f0;
}
.preset-card:active { background: #f8f6fc; }
.preset-name { font-size: 28rpx; font-weight: 700; color: #2d2a35; }
.preset-desc { font-size: 22rpx; color: #7a7485; margin-top: 4rpx; }
.preset-endpoint {
  font-size: 20rpx;
  color: #8b6fd4;
  margin-top: 8rpx;
  word-break: break-all;
  font-family: 'SF Mono', Consolas, monospace;
}

/* Callout */
.callout {
  border-left: 8rpx solid #8b6fd4;
  padding: 24rpx 28rpx;
  background: rgba(139, 111, 212, 0.05);
  border-radius: 0 16rpx 16rpx 0;
}
.callout-title { font-size: 26rpx; font-weight: 700; color: #2d2a35; margin-bottom: 12rpx; }
.callout-text {
  font-size: 22rpx;
  color: #7a7485;
  line-height: 1.8;
  margin-bottom: 4rpx;
}
