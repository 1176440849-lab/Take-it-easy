/* pages/meditation/meditation.wxss */
.page-meditation {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 48rpx 32rpx 32rpx;
}
.ph-title { font-size: 48rpx; font-weight: 700; color: #2d2a35; }
.ph-desc { font-size: 26rpx; color: #7a7485; margin-top: 8rpx; }

/* 今日推荐 */
.recommand-card {
  margin: 0 32rpx 40rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.12);
}
.rc-bg { padding: 48rpx 40rpx; }
.rc-content { position: relative; }
.rc-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #fff;
  margin-bottom: 16rpx;
}
.rc-icon { font-size: 100rpx; margin-bottom: 16rpx; }
.rc-title { font-size: 44rpx; font-weight: 700; color: #fff; margin-bottom: 8rpx; }
.rc-sub { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); margin-bottom: 32rpx; }
.rc-btn {
  display: inline-block;
  background: rgba(255, 255, 255, 0.95);
  color: #2d2a35;
  padding: 16rpx 36rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.rc-btn:active { transform: scale(0.97); }
.rc-btn-locked { background: rgba(255, 255, 255, 0.2); color: #fff; }

/* Section */
.section { margin: 0 32rpx 36rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2a35;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #8b6fd4, #f08a7a);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 场景网格 */
.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.scene-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 1rpx solid #e8e4f0;
  position: relative;
}
.scene-card:active { transform: scale(0.97); }
.scene-card.locked { opacity: 0.65; }
.scene-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 16rpx;
}
.scene-title { font-size: 28rpx; font-weight: 700; color: #2d2a35; margin-bottom: 4rpx; }
.scene-sub { font-size: 22rpx; color: #7a7485; margin-bottom: 12rpx; }
.scene-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
}
.scene-duration { color: #7a7485; }
.scene-soon {
  color: #e8a838;
  background: rgba(232, 168, 56, 0.12);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

/* 冥想记录 */
.log-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8e4f0;
}
.log-item:last-child { border-bottom: none; }
.log-icon { font-size: 40rpx; margin-right: 20rpx; }
.log-info { flex: 1; }
.log-title { font-size: 28rpx; color: #2d2a35; }
.log-meta { font-size: 22rpx; color: #7a7485; margin-top: 4rpx; }
.log-complete {
  color: #4caf7d;
  font-size: 32rpx;
  font-weight: 700;
}

.bottom-tip {
  margin: 40rpx 32rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7a7485;
  background: rgba(139, 111, 212, 0.04);
  border-radius: 16rpx;
}

/* ===== 播放态 ===== */
.play-mode {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  z-index: 100;
}
.play-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 32rpx 24rpx;
}
.play-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}
.play-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.play-placeholder { width: 64rpx; }

/* 呼吸圆 */
.breath-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}
.breath-ring {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 4s ease-in-out, background 4s ease-in-out;
}
.breath-ring.breathing {
  transform: scale(1.15);
  background: rgba(255, 255, 255, 0.25);
}
.breath-core {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}
.breath-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d2a35;
}
.breath-desc {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.6;
}

/* 进度 */
.play-progress {
  padding: 0 60rpx 32rpx;
}
.progress-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 3rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 3rpx;
  transition: width 1s linear;
}
.progress-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 控制 */
.play-controls {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 32rpx 60rpx 16rpx;
}
.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.ctrl-secondary { color: rgba(255, 255, 255, 0.85); }
.ctrl-secondary:active { transform: scale(0.92); }
.ctrl-icon { font-size: 40rpx; }
.ctrl-secondary text { font-size: 20rpx; }
.ctrl-main {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}
.ctrl-main:active { transform: scale(0.95); }
.ctrl-play-icon { font-size: 48rpx; color: #2d2a35; }

.play-tip {
  text-align: center;
  padding: 16rpx 32rpx 40rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 完成弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(45, 42, 53, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.complete-modal {
  width: 620rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  text-align: center;
}
.cm-emoji { font-size: 96rpx; margin-bottom: 20rpx; }
.cm-title { font-size: 36rpx; font-weight: 700; color: #2d2a35; margin-bottom: 8rpx; }
.cm-desc { font-size: 26rpx; color: #7a7485; }
.cm-divider { height: 1rpx; background: #e8e4f0; margin: 32rpx 0; }
.cm-question { font-size: 28rpx; color: #2d2a35; margin-bottom: 32rpx; font-weight: 600; }
.cm-actions { display: flex; gap: 20rpx; }
.cm-actions .btn { flex: 1; }

/* ===== 背景音乐 BGM ===== */
/* 底部状态条 */
.bgm-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 32rpx 32rpx;
  padding: 18rpx 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  backdrop-filter: blur(8rpx);
}
.bgm-bar:active { background: rgba(255, 255, 255, 0.28); }
.bgm-current {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.bgm-cur-icon {
  font-size: 38rpx;
  margin-right: 16rpx;
}
.bgm-cur-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.bgm-cur-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}
.bgm-cur-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bgm-bar-toggle {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.85);
  transform: rotate(180deg);
  transition: transform 0.3s ease;
  margin-left: 16rpx;
}
.bgm-bar-toggle.is-open {
  transform: rotate(0deg);
}

/* 遮罩 */
.bgm-panel-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(45, 42, 53, 0.45);
  z-index: 10;
}

/* 底部弹出面板 */
.bgm-panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 11;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  overflow-y: auto;
}
.bgm-panel.is-open {
  transform: translateY(0);
}
.bgm-panel-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e0dae8;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}
.bgm-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.bgm-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d2a35;
}
.bgm-panel-close {
  font-size: 32rpx;
  color: #7a7485;
  padding: 8rpx 16rpx;
}

/* BGM 网格 */
.bgm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.bgm-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: #f8f6fc;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}
.bgm-item:active { transform: scale(0.95); }
.bgm-item.active {
  background: rgba(139, 111, 212, 0.12);
  border-color: #8b6fd4;
}
.bgm-item-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.bgm-item-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2d2a35;
  margin-bottom: 4rpx;
}
.bgm-item-desc {
  font-size: 18rpx;
  color: #7a7485;
  line-height: 1.3;
}

/* 音量 */
.bgm-volume {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 8rpx;
  border-top: 1rpx solid #e8e4f0;
}
.bgm-volume-label {
  font-size: 24rpx;
  color: #2d2a35;
  white-space: nowrap;
  margin-right: 16rpx;
}
.bgm-volume-slider {
  flex: 1;
  margin: 0;
}

.bgm-panel-tip {
  text-align: center;
  font-size: 20rpx;
  color: #7a7485;
  margin-top: 16rpx;
}
