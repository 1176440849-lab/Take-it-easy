/* ========== 全局样式（与PRD视觉规范一致） ========== */
page {
  --bg: #f8f6fc;
  --bg2: #ffffff;
  --ink: #2d2a35;
  --muted: #7a7485;
  --rule: #e8e4f0;
  --accent: #8b6fd4;
  --accent2: #f08a7a;
  --success: #4caf7d;
  --warning: #e8a838;
  --danger: #e85a5a;
  --gradient-start: rgba(139, 111, 212, 0.08);
  --gradient-mid: rgba(240, 138, 122, 0.06);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, button, input, textarea, scroll-view { box-sizing: border-box; }

/* 容器 */
.container {
  padding: 0 32rpx;
  position: relative;
  min-height: 100vh;
}

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(139, 111, 212, 0.1);
  box-shadow: 0 4rpx 24rpx rgba(139, 111, 212, 0.06);
}

/* 标题 */
.h1 { font-size: 48rpx; font-weight: 700; color: var(--ink); }
.h2 { font-size: 36rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx; }
.h3 { font-size: 32rpx; font-weight: 600; color: var(--accent); margin-bottom: 12rpx; }
.muted { color: var(--muted); font-size: 24rpx; }
.accent { color: var(--accent); font-weight: 600; }

/* 渐变 */
.gradient-bg {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff;
}
.gradient-text {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s;
}
.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff;
}
.btn-primary:active { transform: scale(0.97); opacity: 0.9; }
.btn-ghost {
  background: rgba(139, 111, 212, 0.08);
  color: var(--accent);
}
.btn-block { display: flex; width: 100%; }
.btn[disabled] { opacity: 0.5; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.tag-p0 { background: rgba(232, 90, 90, 0.12); color: var(--danger); }
.tag-p1 { background: rgba(232, 168, 56, 0.12); color: var(--warning); }
.tag-p2 { background: rgba(76, 175, 125, 0.12); color: var(--success); }
.tag-mvp { background: rgba(139, 111, 212, 0.12); color: var(--accent); }

/* 提示框 */
.callout {
  border-left: 8rpx solid var(--accent2);
  padding: 24rpx 28rpx;
  background: rgba(240, 138, 122, 0.06);
  border-radius: 0 16rpx 16rpx 0;
  margin: 24rpx 0;
  font-size: 26rpx;
}
.callout.danger {
  border-left-color: var(--danger);
  background: rgba(232, 90, 90, 0.06);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--rule);
  margin: 24rpx 0;
}

/* 安全区域底部 */
.safe-bottom { padding-bottom: env(safe-bottom); }

/* 隐藏 */
.hidden { display: none !important; }
